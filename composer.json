{
    "name": "omnifox/sdk",
    "description": "Official PHP SDK for the Omnifox.io REST API: inbox, contacts, CRM, boards, calendar, catalog, orders, quotes, workflows and reports.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "omnifox",
        "omnichannel",
        "messaging",
        "whatsapp",
        "instagram",
        "messenger",
        "webchat",
        "crm",
        "sdk",
        "api",
        "laravel"
    ],
    "homepage": "https://omnifox.io/sdk",
    "authors": [
        {
            "name": "Omnifox",
            "email": "support@omnifox.io",
            "homepage": "https://omnifox.io"
        }
    ],
    "support": {
        "email": "support@omnifox.io",
        "docs": "https://omnifox.io/docs/api",
        "issues": "https://github.com/alejandropulley/omnifox-sdk-php/issues",
        "source": "https://github.com/alejandropulley/omnifox-sdk-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Omnifox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnifox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "e2e": "php tests/e2e/e2e.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
